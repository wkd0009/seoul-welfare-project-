import streamlit as st
import pandas as pd
import plotly.express as px

# ==================================================
# 페이지 설정
# ==================================================

st.set_page_config(
    page_title="분석 및 정책 제안",
    page_icon="📊",
    layout="wide"
)

st.title("📊 서울 지하철 혼잡도 분석 및 정책 제안")

st.markdown(
    """
    이 페이지에서는 2023년과 2025년의 서울 지하철 노선별
    평균 혼잡도 데이터를 바탕으로 주요 특징을 분석하고,
